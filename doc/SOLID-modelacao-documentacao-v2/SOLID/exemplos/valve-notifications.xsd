<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- Esquema ILUSTRATIVO criado pela equipa; não prescrito no enunciado -->
  <xs:element name="notifications">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="notification" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="event">
                <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="creation"/><xs:enumeration value="deletion"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="resourcePath" type="xs:string"/>
              <xs:element name="receivedAt" type="xs:dateTime"/>
              <xs:element name="humidity">
                <xs:simpleType><xs:restriction base="xs:decimal"><xs:minInclusive value="0"/><xs:maxInclusive value="100"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="rawPayload" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
